# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# Every key below maps to a field on api.settings.Settings (pydantic-settings
# matches case-insensitively). Keys that the code does not read are deliberately
# absent — an example file full of inert variables is worse than no example.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
# Overrides repo-root path resolution. The Docker image sets this to /app.
# FRAUD_PROJECT_ROOT=/app

# --- Model loading ---
MODEL_ARTIFACT_PATH=models/model_artifact.pkl
MODEL_VERSION=1
# Set true to load from the MLflow Model Registry instead of the local file.
# Requires MLFLOW_TRACKING_URI and a registered model version.
LOAD_FROM_REGISTRY=false
MODEL_REGISTRY_NAME=fraud-detector

# --- Risk banding (business configuration, not model constants) ---
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.70

# --- PostgreSQL (prediction logging) ---
# POSTGRES_PASSWORD also salts the hashed entity identifiers in the prediction
# log, so changing it makes previously written hashes non-comparable.
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fraud_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ENABLE_PREDICTION_LOG=true

# --- Redis (velocity history, prediction cache, rate limit, metrics) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
ENABLE_REDIS=true
PREDICTION_CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS_PER_MINUTE=120
# Retention for per-entity velocity history. Must be >= the widest training
# window (168 h = 604800 s) or online features will not match training.
VELOCITY_HISTORY_SECONDS=604800

# --- Serving limits ---
MAX_BATCH_SIZE=500

# --- MLflow (training and registry) ---
# Unset -> training writes to a local ./mlruns file store.
MLFLOW_TRACKING_URI=http://localhost:5000
