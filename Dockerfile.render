# Serving image for hosts with no persistent volume (Render, Cloud Run).
#
# Differs from the main Dockerfile in two ways: the port comes from $PORT, and
# the model artifact is fetched at build time instead of mounted at runtime.
#
# The artifact is NOT in the repository -- .gitignore excludes model weights on
# purpose -- and a hosted builder gets a fresh clone, so there is nothing to
# COPY. Upload models/model_artifact.pkl as a GitHub Release asset and set
# MODEL_URL to its download URL in the service's environment variables.

FROM python:3.12-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /wheels
COPY requirements.txt .
RUN pip wheel --wheel-dir /wheels -r requirements.txt

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    FRAUD_PROJECT_ROOT=/app PYTHONPATH=/app PORT=8000
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /wheels /wheels
COPY requirements.txt .
RUN pip install --no-index --find-links=/wheels -r requirements.txt && rm -rf /wheels

COPY src/ ./src/
COPY api/ ./api/
COPY configs/ ./configs/

COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && mkdir -p /app/models

RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000

# The artifact is fetched at startup, not at build time, so a new model is a
# restart rather than a rebuild. MODEL_URL is an ordinary environment variable.
ENTRYPOINT ["/app/entrypoint.sh"]
